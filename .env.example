# NEAR by Example - Environment Variables
# Copy this file to .env and fill in values as needed.
# NEVER commit .env to version control.

# Optional: Gemini API key for AI assistant in the examples browser.
# If not set, AI features will be disabled.
# VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override backend URLs (defaults work for standard deployment)
# VITE_RUST_COMPILE_URL=https://your-rust-backend.fly.dev
# VITE_JS_COMPILE_URL=https://your-js-backend.fly.dev
# VITE_DEPLOY_URL=https://your-deploy-backend.fly.dev
