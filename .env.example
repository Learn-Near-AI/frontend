# NEAR by Example - Environment Variables
# Copy this file to .env and fill in values as needed.
# NEVER commit .env to version control.

# Optional: Gemini API key for AI assistant in the examples browser.
# If not set, AI features will be disabled.
# VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override backend URL (defaults work for standard deployment)
# VITE_BACKEND_URL=https://learnnearbyexample.fly.dev

# Optional: Override dev server proxy targets (for local backend development)
# VITE_RPC_PROXY_TARGET=https://test.rpc.fastnear.com
# VITE_BACKEND_PROXY_TARGET=https://learnnearbyexample.fly.dev
